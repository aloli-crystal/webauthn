# Crystal
/docs/        # output de `crystal docs` — on commit `doc/` (singulier) à la place
/lib/
/.shards/
*.dwarf

# Binaires compilés (jamais commités, cf. memory feedback_binaries_no_push)
# Note : git ne peut pas ré-inclure un fichier dont le parent est exclu en bloc.
# Donc on exclut le CONTENU de `/bin/` (avec `*`) et on ré-inclut explicitement
# `bin/init` — sinon `!bin/init` est sans effet (le répertoire est filtré avant).
/bin/*
!/bin/init

# Editor / OS
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Couverture / profilage
/coverage/

# Fixtures temporaires
*.tmp
/tmp/
/spec/tmp/

# surcharge de dépendances pour le développement local
shard.override.yml
